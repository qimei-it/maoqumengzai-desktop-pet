{
  "name": "mqmz-desktop-pet",
  "productName": "毛趣萌仔",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "毛趣萌仔 P0 桌面交互原型",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run check:design && npm run check:icons && npm run typecheck && electron-vite build",
    "check:icons": "node scripts/check-icons.mjs",
    "sync:design": "node scripts/sync-design-tokens.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "generate:icons": "node scripts/generate-native-icons.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "fflate": "^0.8.2",
    "opencc-js": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
